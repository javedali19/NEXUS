# Application Environment
APP_ENV=development
LOG_LEVEL=info
PORT=8080

# Database & PostgreSQL (Current & Supabase)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform_db
DATABASE_MAX_CONNECTIONS=20

# Supabase PostgreSQL Platform (Primary Database Integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER-ONLY: NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend or browser code
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Auth & Security
JWT_SECRET=super-secret-jwt-key-min-32-chars-long!
TOKEN_EXPIRATION_HOURS=24

# Google Cloud Configuration
GCP_PROJECT_ID=enterprise-platform-dev
GCP_REGION=us-central1
GCP_PUBSUB_TOPIC_EVENTS=projects/enterprise-platform-dev/topics/platform-events
GCP_TASKS_QUEUE_NAME=projects/enterprise-platform-dev/locations/us-central1/queues/platform-tasks
GCP_STORAGE_BUCKET=enterprise-platform-dev-assets
GCP_KMS_KEY_NAME=projects/enterprise-platform-dev/locations/us-central1/keyRings/platform-ring/cryptoKeys/data-key

# Google Cloud Identity Platform (GCIP / Firebase Auth)
# Leave blank for local development session mode; configure for production cloud identity
GCP_IDENTITY_PLATFORM_PROJECT_ID=
GCP_IDENTITY_PLATFORM_API_KEY=
GCP_IDENTITY_PLATFORM_TENANT_ID=

# Observability & Sentry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=

# AI Model Providers (OpenAI, Google Gemini, Anthropic)
# Required for autonomous AI Sales Agent. The agent remains DISABLED until validated.
AI_PROVIDER=openai
AI_MODEL_NAME=gpt-4o
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_DEEP=

# Telephony Provider: disabled (Twilio removed, provider-neutral simulation/fallback active)
TELEPHONY_PROVIDER=disabled

# Speech-To-Text (STT) Provider (Deepgram, AssemblyAI, or Google Speech-to-Text)
# Selected: Deepgram (nova-2 streaming, ultra-low latency)
# Server-side secret reference: gsm://deepgram-api-key
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# Voice Synthesis: disabled (ElevenLabs removed, graceful text/telephony fallback)
TTS_PROVIDER=disabled

# Next.js Frontend Config
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ============================================================================
# Southeast Asia Regional Integrations (Activated per Country Pack)
# Credentials required ONLY when corresponding regional provider is activated.
# ============================================================================

# 1. Singapore Payments (DBS RAPID & PayNow SGQR)
# PayNow proxy type: UEN or MOBILE
DBS_RAPID_CLIENT_ID=
DBS_RAPID_API_KEY=
DBS_PAYNOW_PROXY_ID=
DBS_SIGNING_PRIVATE_KEY=

# 2. Malaysia Payments & E-Invoicing (Curlec / DuitNow & LHDN MyInvois)
MY_CURLEC_APP_ID=
MY_CURLEC_SECRET_KEY=
LHDN_MYINVOIS_CLIENT_ID=
LHDN_MYINVOIS_CLIENT_SECRET=
LHDN_DIGITAL_CERT_REF=

# 3. Thailand Payments & E-Tax (PromptPay 2C2P/Omise & Thai RD e-Tax)
TH_OMISE_PUBLIC_KEY=
TH_OMISE_SECRET_KEY=
THAI_RD_ETAX_SERVICE_CODE=
THAI_RD_API_KEY=
THAI_RD_CERTIFICATE_REF=

# 4. LINE Official Account for Thailand (LINE Messaging API)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 5. Regional Messaging Gateway (Multi-Carrier SMS & Viber for SEA)
REGIONAL_SMS_PROVIDER=provider_neutral
REGIONAL_SMS_API_KEY=
REGIONAL_SMS_SENDER_ID=

# 6. Local Communication Services (Regional SIP Trunks: Singtel, Maxis, AIS)
REGIONAL_SIP_TRUNK_DOMAIN=
REGIONAL_SIP_AUTH_USER=
REGIONAL_SIP_PASSWORD=
REGIONAL_CARRIER_PEER=

